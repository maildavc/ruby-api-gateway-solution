{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=SeaBaasAPIGateway-Database;Username=phroneiq;Password=PhroneiqAdmin@123;Search Path=\"SeaBaasAPIGateway-Core\";Include Error Detail=true",
    "Redis": "localhost:6379,password=PhroneiqAdmin@123,abortConnect=false"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "EnableIdempotence": true,
    "MaxInFlight": 5,
    "MessageTimeoutMs": 30000
  },
  "Jwt": {
    "Authority": "https://your-auth-server.com",
    "Audience": "SeaBaasAPIGateway",
    "RequireHttpsMetadata": true,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true
  },
  "OpenTelemetry": {
    "ServiceName": "SeaBaasAPIGateway",
    "ServiceVersion": "1.0.0"
  },
  "PolicyRefresh": {
    "IntervalSeconds": 30
  }
}
